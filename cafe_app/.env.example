# Variables para docker compose. Copia este archivo a .env y complétalo (.env no se sube al repo).

# firma las sesiones de la app (cualquier texto largo y aleatorio: openssl rand -hex 32)
CAFE_JWT_SECRET=
# protege el MCP: lo comparten el MCP y los agentes (openssl rand -hex 32)
CAFE_MCP_TOKEN=
# Gemini: coordinador, administrador, analista, flujos y la panadería
GOOGLE_API_KEY=
# Claude: barista y reseñas
ANTHROPIC_API_KEY=

# opcionales
# CAFE_PORT=8080
# CAFE_GEMINI_MODEL=gemini-3.5-flash-lite
# CAFE_BARISTA_MODEL=claude-haiku-4-5
# BAKERY_GEMINI_MODEL=gemini-3.5-flash-lite
